# Data - never commit. Raw LendingClub is ~1.6 GB.
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# Model artefacts. models/champion.json is the exception and is committed:
# it is what the service and its container load (D12).
*.joblib
*.pkl
*.onnx

# Run tracking and the model registry (D15). Local to whoever trained.
mlruns/

# Vector stores and embedding caches (layer 2). Derived from the committed
# corpus by a documented command, so there is nothing to preserve here.
.chroma/
*.faiss
*.npy

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# OS / editor
.DS_Store
.idea/
.vscode/
Thumbs.db
# Local-only notes. Not part of the public artefact.
*.local.md
